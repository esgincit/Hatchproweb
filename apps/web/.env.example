# Template only — no real values. Copy to .env.local for local dev, or set these on the host (Vercel etc.) for QA/production.
# Values: Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local tests / scripts only (they reset data with it). Never set it on a hosted web app.
# SUPABASE_SERVICE_ROLE_KEY=

# Demo / QA with the seed data only: pins "today" so the fixed-date demo data looks current. Leave unset in production.
# APP_TODAY=2026-10-19

# Web Push public key (pair with VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY secrets of the daily-alerts function)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cloudflare Turnstile site key for /apply (pair with the apply-otp function's TURNSTILE_SECRET_KEY). Test key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

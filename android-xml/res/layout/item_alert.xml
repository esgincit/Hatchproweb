<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="10dp">
    <View android:id="@+id/stripe" android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/pos_crit"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="13.5sp" android:textColor="@color/pos_ink" tools:text="Mortality 2.6× baseline in Shed 2"/>
        <TextView android:id="@+id/body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/pos_ink2" tools:text="47 deaths over 3 days. AI flags Newcastle (81%)."/>
    </LinearLayout>
</LinearLayout>

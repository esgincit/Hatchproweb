<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_tile">
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/pos_muted" tools:text="Birds alive"/>
    <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/pos_ink" android:fontFeatureSettings="tnum" tools:text="65,118"/>
    <TextView android:id="@+id/delta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/pos_muted" tools:text="4 active batches"/>
</LinearLayout>
